UIWidget
  anchors.fill: parent
  visible: false

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    height: 22

    OptionCheckBoxWithHelp
      id: onlyCaptureGameWindow
      !text: tr('Only Capture Game Window')
      !tooltip: tr("If you check this option, the screenshots will only be taken from\nthe game window instead of the complete client interface. This\nmight improve your game performance, particularly if you have\nticked the Screenshot Backlog option.")

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    height: 22
    margin-top: 5

    OptionCheckBoxWithHelp
      id: keepBacklog
      !text: tr('Keep Backlog of the Screenshots of the Last 5 Seconds')
      !tooltip: tr("If you check this option, the client takes a screenshot every\nsecond and caches the last 5 of them. Whenever a screenshot is\ntaken either automatically for a selected event or manually using a\nhotkey, also the screenshots of the previous 5 seconds will be\nsaved.\nIf you experience frame stuttering, you should consider\ndisabling this option.")

  SmallReversedQtPanel
    id: autoScreenshotsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    height: 200
    margin-top: 5

    OptionCheckBoxWithHelp
      id: enableAutoScreenshots
      !text: tr('Enable Auto Screenshots')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      !tooltip: tr("Enable this option to save screenshots of the most important\nmoments of your Tibia career! Whenever one of the events you\nhave selected takes place, a screenshot will be taken\nautomatically.")

    Label
      id: selectEventsCaption
      !text: tr('Select all events that should trigger auto screenshots:')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 5
      margin-left: 18
      font: $var-cip-font
      color: #b9b9b9ff
      text-align: left

    UIWidget
      id: leftColumn
      anchors.left: parent.left
      anchors.top: prev.bottom
      margin-top: 5
      margin-left: 18
      width: 200
      height: 180

      OptionCheckBox
        id: levelUp
        !text: tr('Level Up')
        anchors.left: parent.left
        anchors.top: parent.top

      OptionCheckBox
        id: skillUp
        !text: tr('Skill Up')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 3

      OptionCheckBox
        id: achievement
        !text: tr('Achievement')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 3

      OptionCheckBox
        id: bestiaryUnlocked
        !text: tr('Bestiary Entry Unlocked')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 3

      OptionCheckBox
        id: bestiaryCompleted
        !text: tr('Bestiary Entry Completed')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 3

      OptionCheckBox
        id: treasureFound
        !text: tr('Treasure Found')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 3

      OptionCheckBox
        id: valuableLoot
        !text: tr('Valuable Loot')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 3

      OptionCheckBox
        id: bossDefeated
        !text: tr('Boss Defeated')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 3

    UIWidget
      id: rightColumn
      anchors.left: leftColumn.right
      anchors.top: leftColumn.top
      margin-left: 10
      width: 200
      height: 180

      OptionCheckBox
        id: deathPvE
        !text: tr('Death PvE')
        anchors.left: parent.left
        anchors.top: parent.top

      OptionCheckBox
        id: deathPvP
        !text: tr('Death PvP')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 3

      OptionCheckBox
        id: playerKill
        !text: tr('Player Kill')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 3

      OptionCheckBox
        id: playerKillAssist
        !text: tr('Player Kill Assist')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 3

      OptionCheckBox
        id: playerAttacking
        !text: tr('Player Attacking')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 3

      OptionCheckBox
        id: highestDamage
        !text: tr('Highest Damage Dealt')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 3

      OptionCheckBox
        id: highestHealing
        !text: tr('Highest Healing Done')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 3

      OptionCheckBox
        id: lowHealth
        !text: tr('Low Health')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 3

      OptionCheckBox
        id: giftOfLife
        !text: tr('Gift of Life Triggered')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 3

  QtButton
    id: openFolder
    !text: tr('Open Screenshot Folder')
    size: 130 20
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    color: $var-text-color
    @onClick: modules.game_screenshot.OpenFolder()

  QtButton
    id: resetBtn
    !text: tr('Reset')
    size: 60 20
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    color: $var-text-color
    @onClick: modules.client_options.resetPageToDefaults("miscScreenshots")
