HirelingConfigLabel < Label
  font: $var-cip-font-new
  color: #c0c0c0

StoreWindow
  id: hirelingConfigWindow
  size: 350 158
  padding: 3
  visible: false
  !text: tr('Hireling Configuration')
  font: $var-cip-font-new
  color: #909090
  text-offset: 0 2

  HirelingConfigLabel
    id: descriptionText
    !text: tr('Please enter the name of your new hireling and choose its sex.')
    text-wrap: true
    text-auto-resize: true
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 26
    margin-left: 12
    margin-right: 12

  HirelingConfigLabel
    id: nameLabel
    !text: tr('Hireling name:')
    width: 90
    anchors.top: descriptionText.bottom
    anchors.left: parent.left
    margin-top: 12
    margin-left: 12

  TextEdit
    id: transferPointsText
    height: 16
    max-length: 29
    font: $var-cip-font-new
    color: #c0c0c0
    anchors.verticalCenter: nameLabel.verticalCenter
    anchors.left: nameLabel.right
    anchors.right: parent.right
    margin-left: 6
    margin-right: 12
    text-align: left

  HirelingConfigLabel
    id: sexLabel
    !text: tr('Hireling sex:')
    width: 90
    anchors.top: nameLabel.bottom
    anchors.left: parent.left
    margin-top: 14
    margin-left: 12

  QtComboBox
    id: sexCombo
    height: 20
    font: $var-cip-font-new
    color: #c0c0c0
    anchors.verticalCenter: sexLabel.verticalCenter
    anchors.left: sexLabel.right
    anchors.right: parent.right
    margin-left: 6
    margin-right: 12

  HorizontalSeparator
    anchors.left: parent.left
    margin-left: 12
    anchors.right: parent.right
    margin-right: 12
    anchors.top: closeButton.top
    margin-top: -12

  CipsoftButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 12
    margin-bottom: 12
    !text: tr('Cancel')
    size: 86 20
    text-offset: 0 1
    color: #ffffff

  CipsoftButton
    id: buttonOk
    anchors.right: closeButton.left
    anchors.bottom: closeButton.bottom
    margin-right: 10
    !text: tr('Buy Now')
    size: 86 20
    text-offset: 0 1
    color: #ffffff
    enabled: false

    $disabled:
      color: #c0c0c0
      opacity: 0.8
      change-cursor-image: false

    $hover !disabled:
      color: #ffffff
