Panel
  id: background
  # The official resource is a JPEG, but OTClient's runtime loader does not
  # decode it on this path. This PNG is a lossless pixel-preserving conversion
  # of the same extracted 15.3x title.jpg, not a legacy Crystal background.
  image-source: /images/title-official
  // smoothing enabled: backgrounds are scaled to the window size, without smooth pixels are visible
  image-smooth: true
  // Match the official client's Image.PreserveAspectCrop title treatment.
  image-fixed-ratio: true
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.bottom: parent.bottom

  focusable: false

  UIWidget
    id: serverLogo
    size: 196 112
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    margin-top: -162
    image-source: /images/client_entergame/client-dragon-logo-regular
    focusable: false
    phantom: true
    visible: false

  UIWidget
    id: cipSoftLogo
    size: 163 44
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    # Official gamewindow.qml anchors this mark to the 117 px bottom bar.
    margin-bottom: 117
    image-source: /images/skin/classic/cipsoft-logo
    focusable: false
    phantom: true
