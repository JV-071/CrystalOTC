{
  "schemaVersion": 1,
  "canonicalBackend": "opengl-llvmpipe",
  "captureSize": [1020, 644],
  "defaultTolerance": { "channelTolerance": 2, "maxDifferentFraction": 0.001 },
  "scenes": [
    {
      "id": "startup-ui",
      "automation": "client",
      "requiresOnlineGame": false,
      "features": ["login-background", "bitmap-font", "ttf-font", "icons", "translucent-ui", "initial-resize"],
      "command": "--renderer-baseline=startup-ui --renderer-baseline-output=startup-ui.png"
    },
    {
      "id": "map-core",
      "automation": "client+fixture-server",
      "requiresOnlineGame": true,
      "features": ["floors", "tiles", "creatures", "missiles", "effects", "camera-movement", "map-fbo"],
      "command": "--renderer-baseline=map-core --renderer-baseline-output=map-core.png"
    },
    {
      "id": "lighting-overlap",
      "automation": "fixture-server",
      "requiresOnlineGame": true,
      "features": ["day-night", "colored-lights", "overlapping-lights", "dynamic-texture-upload", "multiply"]
    },
    {
      "id": "ui-clipping-opacity",
      "automation": "client",
      "requiresOnlineGame": false,
      "features": ["nested-clipping", "rotated-clipping", "scroll-area", "opacity", "overlapping-alpha"],
      "command": "--renderer-baseline=ui-clipping-opacity --renderer-baseline-output=ui-clipping-opacity.png"
    },
    {
      "id": "text-matrix",
      "automation": "client",
      "requiresOnlineGame": false,
      "features": ["bitmap-font", "ttf-font", "ttf-stroke", "outlined-text", "font-scale", "alignment", "rotation"],
      "command": "--renderer-baseline=text-matrix --renderer-baseline-output=text-matrix.png"
    },
    {
      "id": "outfit-masks",
      "automation": "client",
      "requiresOnlineGame": false,
      "features": ["outfit-mask-colors", "mount", "addons", "multiply", "creature-preview-fbo", "outline-framebuffer", "nested-fbo", "time-shader"],
      "command": "--renderer-baseline=outfit-masks --renderer-baseline-output=outfit-masks.png",
      "ciGate": false,
      "ciGateReason": "Renders outfit, mount and addon previews from data/things/*, which is gitignored. A CI runner has no game assets, so this scene captures an empty preview there; gating it would freeze a blank image as the accepted reference. Captured and archived as an artifact only."
    },
    {
      "id": "particles-blends",
      "automation": "client",
      "requiresOnlineGame": false,
      "features": ["particles", "single-burst-emitter", "normal", "multiply", "add-weird"],
      "command": "--renderer-baseline=particles-blends --renderer-baseline-output=particles-blends.png"
    },
    {
      "id": "composition-all",
      "automation": "client+native-fixture",
      "requiresOnlineGame": false,
      "features": ["normal", "multiply", "add-weird", "replace", "destination-blending", "light-modulate", "retained-destination"],
      "command": "--renderer-baseline=composition-all --renderer-baseline-output=composition-all.png"
    },
    {
      "id": "temporary-framebuffers",
      "automation": "client",
      "requiresOnlineGame": false,
      "features": ["creature-preview", "outline-shader", "thing-framebuffer", "item-widget-flip-horizontal", "item-widget-flip-vertical", "effect-widget", "missile-widget", "spell-preview", "nested-fbo"],
      "command": "--renderer-baseline=temporary-framebuffers --renderer-baseline-output=temporary-framebuffers.png",
      "ciGate": false,
      "ciGateReason": "Renders creature, item, effect and missile widget previews from data/things/*, which is gitignored. A CI runner has no game assets, so this scene captures empty previews there; gating it would freeze a blank image as the accepted reference. Captured and archived as an artifact only."
    },
    {
      "id": "graph-lines",
      "automation": "client",
      "requiresOnlineGame": false,
      "features": ["uigraph", "gl-line-strip", "line-smoothing", "line-width-1", "line-width-3", "line-width-6"],
      "command": "--renderer-baseline=graph-lines --renderer-baseline-output=graph-lines.png"
    },
    {
      "id": "shader-matrix",
      "automation": "fixture-server",
      "requiresOnlineGame": true,
      "features": ["all-module-shaders", "fog-multitexture", "snow-multitexture", "outline-framebuffer"]
    },
    {
      "id": "atlas-resources",
      "automation": "client",
      "requiresOnlineGame": false,
      "features": ["atlas-growth", "linear-filter-group", "smooth-padding", "large-texture", "animated-texture", "gc-reload"],
      "command": "--renderer-baseline=atlas-resources --renderer-baseline-output=atlas-resources.png"
    },
    {
      "id": "windowing",
      "automation": "desktop-driver",
      "requiresOnlineGame": false,
      "features": ["resize", "display-density", "fullscreen", "focus", "display-move"]
    },
    {
      "id": "map-screenshot",
      "automation": "client+fixture-server",
      "requiresOnlineGame": true,
      "features": ["map-readback", "asymmetric-margin-crop", "vertical-flip"],
      "captureSize": [480, 352],
      "command": "--renderer-baseline=map-screenshot --renderer-baseline-output=map-screenshot.png"
    }
  ]
}
