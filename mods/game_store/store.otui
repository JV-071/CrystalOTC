MainWindow
  id: storeWindow
  !text: tr('Store')
  size: 780 630
  margin-top: -50
  margin-left: -30
  @onEscape: modules.game_store.closeStore()
  @onEnter: modules.game_store.onEnterSearch()
  Panel
    id: categories
    anchors.top: parent.top
    anchors.left: parent.left
    size: 180 545
    image-source: /images/ui/2pixel-up-frame-borderimage-dark
    image-border: 4
    image-border-top: 17
    margin-top: -6
  TextEdit
    id: searchText
    size: 166 22
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-left: 7
    margin-bottom: 55
    font: $var-cip-font
    color: $var-text-cip-color
    padding-left: 4
    padding-top: 3
    !placeholder: tr('Type to search')
    placeholder-font: $var-cip-font
    placeholder-color: #707070
    placeholder-align: LeftCenter
    box-text-padding: 27
    focusable: true
    @onTextChange: modules.game_store.onSearchEdit(self)
    Button
      id: searchIcon
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: parent.right
      size: 20 20
      margin-top: -2
      margin-right: 1
      image-source: /images/store/search-up
      image-clip: 0 0 20 20
      enabled: false
      $hover !disabled:
        image-clip: 0 0 20 20
      $pressed:
        image-clip: 0 20 20 20
      $disabled:
        image-clip: 0 40 20 20
      @onClick: modules.game_store.onEnterSearch(self:getParent())
  Panel
    id: contentPanel
    size: 563 545
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: -6
  HorizontalSeparator
    id: separator
    anchors.top: categories.bottom
    margin-top: 10
    anchors.left: parent.left
    anchors.right: parent.right
  Panel
    id: coinsPanel
    size: 469 20
    anchors.top: separator.bottom
    anchors.left: parent.left
    margin-top: 10
    layout:
      type: horizontalBox
      cell-spacing: 5
    UIWidget
      id: streamerPanel
      size: 130 20
      image-source: /images/ui/progress
      image-border: 7
      visible: false
      tooltip-delayed: true
      UIWidget
        image-source: /images/store/icon-rubinotcoin
        anchors.right: parent.right
        anchors.top: parent.top
        margin-top: 4
        margin-right: 4
        phantom: true
      UIWidget
        id: streamerCoin
        !text: tr('0')
        anchors.top: parent.top
        anchors.right: prev.left
        margin-right: 5
        margin-top: 2
        text-auto-resize: true
        phantom: true
        color: #c0c0c0
        font: Verdana Bold-11px
        tooltip-font: $var-cip-font-wheel

    UIWidget
      id: coinPanel
      size: 130 20
      image-source: /images/ui/progress
      image-border: 7
      tooltip-delayed: true
      UIWidget
        image-source: /images/store/icon-rubinotcointransferable
        anchors.right: parent.right
        anchors.top: parent.top
        margin-top: 4
        margin-right: 4
        phantom: true
      UIWidget
        id: tibiacointransferable
        !text: tr('0')
        anchors.top: parent.top
        anchors.right: prev.left
        margin-right: 5
        margin-top: 2
        phantom: true
        text-auto-resize: true
        color: #c0c0c0
        font: Verdana Bold-11px
        tooltip-font: $var-cip-font-wheel

    UIButton
      id: getCoins
      size: 64 20
      margin-left: 5
      image-source: /images/store/get-up
      image-clip: 0 0 64 20
      !tooltip: tr('Get Rubini Coins')
      $hover !pressed:
        image-clip: 0 0 64 20
      $pressed:
        image-source: /images/store/get-down
        image-clip: 0 0 64 20
      @onClick: choseBuyCoins(self)

    Button
      id: transferTibiaCoins
      size: 64 20
      margin-left: 5
      image-source: /images/store/transfer-coin-up
      image-clip: 0 0 64 20
      !tooltip: tr('Gift Rubini Coins to another character.')
      $hover !pressed:
        image-clip: 0 0 64 20
      $pressed:
        image-source: /images/store/transfer-coin-down
        image-clip: 0 0 64 20
      @onClick: modules.game_store.onGiftWindow()

    Button
      id: auctionCharacter
      size: 64 20
      margin-left: 5
      image-source: /images/store/baazar
      image-clip: 0 0 64 20
      !tooltip: tr('Set up an auction to sell your current character')
      $hover:
        image-clip: 0 0 64 20
      $pressed:
        image-source: /images/store/baazar-down
        image-clip: 0 0 64 20
      @onClick: function() modules.game_store.closeStore() modules.game_store.openBaazarWindow() end

  Button
    id: historyButton
    anchors.top: separator.bottom
    anchors.right: close.left
    margin-top: 10
    margin-right: 5
    size: 43 20
    !text: tr('History')
    @onClick: modules.game_store.requestHistory()

  Button
    id: close
    anchors.top: separator.bottom
    anchors.right: parent.right
    margin-top: 10
    margin-left: 5
    size: 43 20
    !text: tr('Close')
    @onClick: modules.game_store.closeStore()
