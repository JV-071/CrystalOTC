BattlePassMissionWidget < Panel
  size: 144 25
  phantom: false
  tooltip-font: pVerdana Bold-11px
  tooltip-delayed: true
  @onClick: modules.game_trackers.BattlePassTracker.onOpenBattlePass()
  UIWidget
    id: missionIcon
    size: 23 23
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: -2
    margin-left: -3
    image-source: /images/game/battlepass/bronze-icon
    phantom: true
  Label
    id: missionName
    anchors.top: parent.top
    anchors.left: missionIcon.right
    margin-top: -4
    margin-left: 1
    text: Mission Name
    font: $var-cip-font
    color: $var-text-cip-color
    text-auto-resize: true
    text-overflow-length: 18
    phantom: true

  ProgressBar
    id: progressBar
    height: 5
    anchors.top: missionName.bottom
    anchors.left: missionIcon.right
    anchors.right: parent.right
    margin-top: 4
    margin-right: 4
    margin-left: 2
    background-color: #C28400
    color: $var-text-cip-color
    phantom: true

MiniWindow
  id: battlepassTracker
  &type: 'battlepassTracker'
  !text: tr('Battle Pass Tr...')
  font: $var-cip-font
  text-offset: 18 0
  height: 80
  icon: /images/icons/icon-analyticsselector-widget
  @onClose: modules.game_trackers.BattlePassTracker.onClose()
  @onExtra: modules.game_trackers.BattlePassTracker.showSortOptions()
  &save: true
  &autoOpen: false
  MiniWindowContents
    anchors.fill: parent
    margin: 20 17 4 6
    layout: verticalBox
    Panel
      id: headerPanel
      height: 82
      phantom: false
      @onClick: modules.game_trackers.BattlePassTracker.onOpenBattlePass()
      UIWidget
        id: levelIconBg
        size: 81 75
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        image-source: /images/game/battlepass/player-icon-level
        phantom: true
      Label
        id: levelLabel
        text: 0
        anchors.bottom: levelIconBg.bottom
        anchors.horizontalCenter: levelIconBg.horizontalCenter
        text-align: center
        text-auto-resize: true
        font: $var-cip-font
        color: $var-text-cip-color
        margin-bottom: 4
        margin-left: -2
        phantom: true

    HorizontalSeparator
      id: dailySeparator1

    Label
      id: dailyLabel
      !text: tr('Daily Missions')
      font: $var-cip-font
      color: $var-text-cip-color

    HorizontalSeparator
      id: dailySeparator2
      margin-top: 4

    BattlePassMissionWidget
      id: dailySlot1
      margin-top: 2
      margin-left: 3

    BattlePassMissionWidget
      id: dailySlot2
      margin-top: 2
      margin-left: 3
      visible: false

    HorizontalSeparator
      id: generalSeparator1
      margin-top: 3

    Label
      id: generalLabel
      !text: tr('General Missions')
      font: $var-cip-font
      color: $var-text-cip-color

    HorizontalSeparator
      id: generalSeparator2
      margin-top: 4

    BattlePassMissionWidget
      id: generalSlot1
      margin-top: 2
      margin-left: 3

    BattlePassMissionWidget
      id: generalSlot2
      margin-top: 2
      margin-left: 3
      visible: false

    BattlePassMissionWidget
      id: generalSlot3
      margin-top: 2
      margin-left: 3
      visible: false

